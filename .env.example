# ===== MCP 传输与认证 =====
# 传输协议：stdio（默认） / sse / streamable-http
MCP_TRANSPORT=streamable-http
# HTTP 传输监听地址与端口（stdio 模式忽略）
MCP_HOST=0.0.0.0
MCP_PORT=8000
# 设置后启用 Bearer Token 认证，保护 HTTP 接口（强烈建议在生产环境配置）
MCP_AUTH_TOKEN=change-me-to-a-strong-token
# 日志级别：debug / info / warning / error
MCP_LOG_LEVEL=info

# ===== Nacos 连接配置 =====
NACOS_HOST=localhost
NACOS_API_PORT=8848
NACOS_CONSOLE_PORT=8080
NACOS_USERNAME=nacos
NACOS_PASSWORD=your-password
NACOS_NAMESPACE=public
NACOS_VERSION=3
NACOS_READ_ONLY=false
