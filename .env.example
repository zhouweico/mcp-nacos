# ===== MCP 传输与认证 =====
# 传输协议：stdio（默认） / sse / streamable-http
MCP_TRANSPORT=streamable-http
# HTTP 传输监听地址与端口（stdio 模式忽略）
MCP_HOST=0.0.0.0
MCP_PORT=8000
# 设置后启用 Bearer Token 认证，保护 HTTP 接口（强烈建议在生产环境配置）
MCP_AUTH_TOKEN=change-me-to-a-strong-token
# Stateless HTTP 模式：true 时无会话状态，每次请求独立（仅 streamable-http 生效）
MCP_STATELESS_HTTP=false
# 日志级别：debug / info / warning / error
MCP_LOG_LEVEL=info

# Nacos 连接
# 必填，格式：scheme://host[:port][/context-path]
#   1.x/2.x 默认部署：http://<host>:8848/nacos
#   3.x 默认部署：http://<host>:8080
#   经反向代理转发：填网关对外完整地址（包含代理前缀）
# API 段（/v1/cs/configs 等）按 NACOS_VERSION 自动拼接。
NACOS_BASE_URL=http://localhost:8080
NACOS_USERNAME=nacos
NACOS_PASSWORD=your-password
NACOS_NAMESPACE=public
NACOS_VERSION=3
# 只读模式：true（默认）时写工具不注册；false 时启用写工具（需客户端支持 Elicitation 确认）
NACOS_READ_ONLY=true
# 跳过 TLS 证书验证（仅自签名 / 内部 CA 场景）
NACOS_INSECURE=false
